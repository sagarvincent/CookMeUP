PORT=3001

# SQLite file paths (absolute or relative to API/auth/)
AUTH_DB_PATH=../../data/auth.db
PROFILE_DB_PATH=../../data/profile.db

# JWT secrets — change both to long random strings in production
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# Token lifetimes
ACCESS_TOKEN_TTL=900        # 15 minutes in seconds
REFRESH_TOKEN_TTL=2592000   # 30 days in seconds

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:5173
